# Local development config — copy to .env (gitignored). In production these
# are Railway service variables; PORT is injected by Railway.
PORT=8080
HOST=::
RUST_LOG=debug
# Required by `indexer-admin backfill` (ALG-621) and the future ingester;
# read only by the subcommand that needs it, so migrate/seed work without it.
HELIUS_API_KEY=
# Required by indexer-api and indexer-admin (docker-compose exposes Postgres
# on host port 5433). On Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:password@localhost:5433/piggygang_indexer
# DATABASE_MAX_CONNECTIONS=5
# DATABASE_CONNECT_TIMEOUT_SECS=5
# Periodic reconciliation (ALG-624), ingester only. Shorten the interval to
# watch a sweep happen; 0 disables the schedule and leaves the reconcile the
# consumer already runs on every reconnect.
# RECONCILE_INTERVAL_SECS=3600
# RECONCILE_DEEP_INTERVAL_SECS=604800
# RECONCILE_RPS=10
# The tip probe: one searchAssets per collection filter, newest-acted-on first.
# This is the freshness knob; 0 leaves the hourly sweep as the only correction.
# RECONCILE_TIP_INTERVAL_SECS=30
# RARITY_INTERVAL_SECS=86400

# --- Helius webhooks (the ingester's second transport) ---
# Which transports the ingester runs: ws | webhook | ws,webhook.
# INGEST_TRANSPORTS=ws
# The WHOLE Authorization header value Helius echoes on every delivery. It is
# set as the webhook's authHeader by `indexer-admin webhook` and compared
# verbatim by the receiver — Helius offers no HMAC, so this is the entire
# authenticity check. Generate real entropy, e.g. `openssl rand -base64 32`.
HELIUS_WEBHOOK_SECRET=
# The public HTTPS endpoint Helius posts to. Registration only; the receiver
# never reads it. Locally you do not need one.
WEBHOOK_URL=
# The docs and Helius's own SDK disagree on this host; the SDK's is the default.
# HELIUS_WEBHOOK_API=https://api-mainnet.helius-rpc.com
# Drain pacing. Defaults are fine; they exist for a burst you have measured.
# WEBHOOK_POLL_MS=1000
# WEBHOOK_BATCH=50
# WEBHOOK_LEASE_SECS=60
# WEBHOOK_MAX_ATTEMPTS=5
# WEBHOOK_GRACE_SECS=120
# Must outlast a dual-run evaluation window: coverage() reads these rows.
# WEBHOOK_RETAIN_DAYS=30
#
# The ingester now binds PORT for the webhook endpoint. Locally that collides
# with indexer-api's 8080, so run one of them with PORT set elsewhere:
#   PORT=8081 cargo run -p indexer-ingester
