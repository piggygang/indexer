# Local development config — copy to .env (gitignored). In production these
# are Railway service variables; PORT is injected by Railway.
PORT=8080
HOST=::
RUST_LOG=debug
# Required by `indexer-admin backfill` (ALG-621) and the future ingester;
# read only by the subcommand that needs it, so migrate/seed work without it.
HELIUS_API_KEY=
# Required by indexer-api and indexer-admin (docker-compose exposes Postgres
# on host port 5433). On Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:password@localhost:5433/piggygang_indexer
# DATABASE_MAX_CONNECTIONS=5
# DATABASE_CONNECT_TIMEOUT_SECS=5
# Periodic reconciliation (ALG-624), ingester only. Shorten the interval to
# watch a sweep happen; 0 disables the schedule and leaves the reconcile the
# consumer already runs on every reconnect.
# RECONCILE_INTERVAL_SECS=3600
# RECONCILE_DEEP_INTERVAL_SECS=604800
# RECONCILE_RPS=10
