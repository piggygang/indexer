# Local development config — copy to .env (gitignored). In production these
# are Railway service variables; PORT is injected by Railway.
PORT=8080
HOST=::
# Not `trace` with a real key: tungstenite logs the WebSocket upgrade request
# at that level, and the key is in its query string.
RUST_LOG=debug

# --- Cluster (PIG-113) ---
# Which Solana cluster this deployment indexes: mainnet-beta | devnet.
# REQUIRED by every binary and the one variable with no default — a defaulted
# cluster is a deployment that quietly indexes the other chain into this
# database. `mainnet` is not a spelling; it is refused like any other typo.
SOLANA_CLUSTER=mainnet-beta
# The endpoints that reach it. Explicit, never derived from the cluster: each
# is its own variable, so a provider swap is a config change. Give the BARE
# endpoint — HELIUS_API_KEY is appended as `?api-key=` by the client, and a URL
# that already carries a query string or credentials is rejected.
#   SOLANA_RPC_URL  JSON-RPC + DAS. Needed by the ingester and by the admin
#                   commands that read the chain (backfill, backfill-activity);
#                   the api and migrate/seed run without it.
#   SOLANA_WS_URL   Enhanced WebSockets. Needed by the ingester's `ws` transport.
# A hostname that names another cluster fails at parse time, and the ingester
# and those admin commands also compare the RPC's getGenesisHash with the
# cluster's before they write anything.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com
SOLANA_WS_URL=wss://mainnet.helius-rpc.com
# The same three for devnet. Comment out the mainnet lines above rather than
# adding these below them (the first assignment in a .env wins), and point
# DATABASE_URL at a database of its own — never the mainnet one:
# SOLANA_CLUSTER=devnet
# SOLANA_RPC_URL=https://devnet.helius-rpc.com
# SOLANA_WS_URL=wss://devnet.helius-rpc.com

# Required by `indexer-admin backfill` (ALG-621) and the ingester; read only
# by the subcommand that needs it, so migrate/seed work without it. One key
# serves both clusters.
HELIUS_API_KEY=
# Required by indexer-api and indexer-admin (docker-compose exposes Postgres
# on host port 5433). On Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:password@localhost:5433/piggygang_indexer
# DATABASE_MAX_CONNECTIONS=5
# DATABASE_CONNECT_TIMEOUT_SECS=5
# Periodic reconciliation (ALG-624), ingester only. Shorten the interval to
# watch a sweep happen. A transport connecting lowers this to the 600 s
# RECONNECT_FLOOR for one run — a lower bar, never an exemption — so 0 now
# disables the sweep and the deep pass outright, with nothing left behind.
# RECONCILE_INTERVAL_SECS=3600
# RECONCILE_DEEP_INTERVAL_SECS=604800
# RECONCILE_RPS=10
# The tip probe: one searchAssets per collection filter, newest-acted-on first.
# This is the freshness knob; 0 leaves the hourly sweep as the only correction.
# RECONCILE_TIP_INTERVAL_SECS=30
# RARITY_INTERVAL_SECS=86400

# --- Helius webhooks (the ingester's second transport) ---
# Which transports the ingester runs: ws | webhook | ws,webhook.
# INGEST_TRANSPORTS=ws
# The WHOLE Authorization header value Helius echoes on every delivery. It is
# set as the webhook's authHeader by `indexer-admin webhook` and compared
# verbatim by the receiver — Helius offers no HMAC, so this is the entire
# authenticity check. Generate real entropy, e.g. `openssl rand -base64 32`.
HELIUS_WEBHOOK_SECRET=
# The public HTTPS endpoint Helius posts to. Registration only; the receiver
# never reads it. Locally you do not need one.
WEBHOOK_URL=
# The webhook management API host. Needed only by `indexer-admin webhook`, so
# it stays commented until then, and it has no default. It is the same on every
# cluster: Helius manages webhooks per account and puts a webhook's cluster in
# its type (`raw` / `rawDevnet`), which `indexer-admin webhook` derives from
# SOLANA_CLUSTER. `api-devnet.helius-rpc.com` answers 404 for /v0/webhooks, so
# this is also the devnet value, and the one endpoint whose host is not checked
# against SOLANA_CLUSTER. Helius's docs and their own SDK disagree on the host;
# this is the SDK's.
# HELIUS_WEBHOOK_API=https://api-mainnet.helius-rpc.com
# Drain pacing. Defaults are fine; they exist for a burst you have measured.
# WEBHOOK_POLL_MS=1000
# WEBHOOK_BATCH=50
# WEBHOOK_LEASE_SECS=60
# WEBHOOK_MAX_ATTEMPTS=5
# WEBHOOK_GRACE_SECS=120
# Must outlast a dual-run evaluation window: coverage() reads these rows.
# WEBHOOK_RETAIN_DAYS=30
#
# The ingester now binds PORT for the webhook endpoint. Locally that collides
# with indexer-api's 8080, so run one of them with PORT set elsewhere:
#   PORT=8081 cargo run -p indexer-ingester
